# Copia este archivo como .env.local y rellena los valores reales.
# NUNCA subas .env.local al repositorio: contiene credenciales.

# Cadena de conexión de la base de datos Postgres (Neon).
# Se obtiene en el panel de Neon o desde la integración de Vercel.
DATABASE_URL=

# Clave secreta que Payload usa para firmar las sesiones del panel.
# Genera una cadena aleatoria larga. Ejemplo para generarla en la terminal:
#   openssl rand -base64 32
PAYLOAD_SECRET=

# Token de escritura de Vercel Blob, donde se guardan las imágenes y PDFs.
# Vercel lo crea automáticamente al añadir Blob Storage al proyecto.
BLOB_READ_WRITE_TOKEN=

# Dirección pública del sitio. En local se deja como está.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
